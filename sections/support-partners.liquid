<div class="support-partners page-width" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <div class="support-partners__header">
      <h2 class="support-partners__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="support-partners__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="support-partners__grid support-partners__grid--{{ section.settings.columns_desktop }}-col" role="list">
      {%- for block in section.blocks -%}
        <li class="support-partners__item" {{ block.shopify_attributes }}>
          <a
            class="support-partners__link"
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="presentation"{% endif %}
            {% if block.settings.link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
          >
            {%- if block.settings.logo != blank -%}
              <div class="support-partners__logo-wrapper">
                {{
                  block.settings.logo
                  | image_url: width: 400
                  | image_tag:
                    class: 'support-partners__logo',
                    widths: '100, 200, 300, 400',
                    sizes: '(min-width: 990px) calc(100vw / {{ section.settings.columns_desktop }}), (min-width: 750px) calc(100vw / 3), calc(50vw)',
                    alt: block.settings.partner_name | escape
                }}
              </div>
            {%- else -%}
              <div class="support-partners__logo-wrapper support-partners__logo-wrapper--placeholder">
                {{ 'image' | placeholder_svg_tag: 'support-partners__placeholder' }}
              </div>
            {%- endif -%}

            {%- if block.settings.partner_name != blank -%}
              <span class="support-partners__name">{{ block.settings.partner_name | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

<style>
  .support-partners {
    box-sizing: border-box;
    margin: 0 auto;
  }

  .support-partners__header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .support-partners__heading {
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    margin: 0 0 0.8rem;
    color: var(--color-foreground);
  }

  .support-partners__subheading {
    font-size: 1.6rem;
    color: var(--color-foreground-muted, var(--color-foreground));
    margin: 0;
    opacity: 0.75;
  }

  .support-partners__grid {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.4rem;
  }

  /* Mobile: 2 columns */
  .support-partners__grid--2-col,
  .support-partners__grid--3-col,
  .support-partners__grid--4-col,
  .support-partners__grid--5-col,
  .support-partners__grid--6-col {
    grid-template-columns: repeat(2, 1fr);
  }

  @media screen and (min-width: 750px) {
    .support-partners__grid--2-col { grid-template-columns: repeat(2, 1fr); }
    .support-partners__grid--3-col { grid-template-columns: repeat(3, 1fr); }
    .support-partners__grid--4-col { grid-template-columns: repeat(3, 1fr); }
    .support-partners__grid--5-col { grid-template-columns: repeat(3, 1fr); }
    .support-partners__grid--6-col { grid-template-columns: repeat(4, 1fr); }
  }

  @media screen and (min-width: 990px) {
    .support-partners__grid--2-col { grid-template-columns: repeat(2, 1fr); }
    .support-partners__grid--3-col { grid-template-columns: repeat(3, 1fr); }
    .support-partners__grid--4-col { grid-template-columns: repeat(4, 1fr); }
    .support-partners__grid--5-col { grid-template-columns: repeat(5, 1fr); }
    .support-partners__grid--6-col { grid-template-columns: repeat(6, 1fr); }
  }

  .support-partners__item {
    display: flex;
  }

  .support-partners__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    width: 100%;
    padding: 2rem 1.6rem;
    border: 0.1rem solid rgba(var(--color-foreground-rgb, 0 0 0) / 0.1);
    border-radius: 0.8rem;
    text-decoration: none;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    background-color: var(--color-background);
  }

  .support-partners__link:hover {
    box-shadow: 0 0.4rem 1.6rem rgba(var(--color-foreground-rgb, 0 0 0) / 0.1);
    transform: translateY(-0.2rem);
  }

  .support-partners__logo-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .support-partners__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }

  .support-partners__link:hover .support-partners__logo {
    opacity: 0.85;
  }

  .support-partners__logo-wrapper--placeholder {
    background-color: var(--color-background-muted, #f3f3f3);
    border-radius: 0.4rem;
  }

  .support-partners__placeholder {
    width: 60%;
    height: 60%;
    fill: var(--color-foreground-muted, #aaa);
  }

  .support-partners__name {
    font-size: 1.4rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-foreground);
    word-break: break-word;
  }
</style>

{% schema %}
{
  "name": "Support Partners Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Partners"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Proud to be supported by the following organisations"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Partner logo"
        },
        {
          "type": "text",
          "id": "partner_name",
          "label": "Partner name",
          "default": "Partner Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Support Partners Page",
      "blocks": [
        {
          "type": "partner",
          "settings": {
            "partner_name": "Florida Panthers"
          }
        },
        {
          "type": "partner",
          "settings": {
            "partner_name": "Carolina Panthers"
          }
        },
        {
          "type": "partner",
          "settings": {
            "partner_name": "Penrith Panthers"
          }
        },
        {
          "type": "partner",
          "settings": {
            "partner_name": "Partner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
